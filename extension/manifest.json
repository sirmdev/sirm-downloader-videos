{
  "manifest_version": 3,
  "name": "SirM Downloader Videos",
  "version": "1.2.0",
  "description": "Baixe vídeos compatíveis (MP4, HLS, DASH) no seu computador, com escolha de qualidade. Requer o auxiliar local gratuito.",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SirM Downloader Videos — baixar vídeo desta aba",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "homepage_url": "https://github.com/sirmdev/sirm-downloader-videos"
}
